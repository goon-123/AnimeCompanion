+/// Generic collections contain boxed values, unlike primitive iterators.
+/// Bound host-side expansion too: it must not bypass the guest instruction cap.
+fn boxed_range(
+    vm: &mut Vm,
+    first: i64,
+    last: i64,
+    step: i64,
+    class: &str,
+) -> Result<Vec<JValue>, NatErr> {
+    if step == 0 {
+        return Err(iae(vm, "zero progression step"));
+    }
+    let distance = i128::from(last) - i128::from(first);
+    let count = if (step > 0 && distance < 0) || (step < 0 && distance > 0) {
+        0
+    } else {
+        distance / i128::from(step) + 1
+    };
+    if count > 100_000 || count as i64 > vm.budget {
+        return Err(nat_fatal(JvmError::Fatal(
+            "Range expansion exceeds VM budget".into(),
+        )));
+    }
+    vm.budget -= count as i64;
+    (0..count)
+        .map(|index| {
+            let value = (i128::from(first) + index * i128::from(step)) as i64;
+            let native = match class {
+                "Ljava/lang/Character;" => Native::CharBox(value as u16),
+                "Ljava/lang/Long;" => Native::LongBox(value),
+                _ => Native::IntBox(value as i32),
+            };
+            alloc(vm, class, native)
+        })
+        .collect()
+}
