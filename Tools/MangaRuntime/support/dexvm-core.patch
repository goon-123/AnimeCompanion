+    body: &Option<JValue>,
+) -> Result<RequestPayload, NatErr> {
+    let Some(body) = body.filter(|value| !value.is_null()) else {
+        return Ok((None, None));
+    };
+    let (bytes, content_type) = match payload(vm, body) {
+        Some(Native::FormBody(fields)) => (
+            fields
+                .iter()
+                .map(|(key, value)| format!("{key}={value}"))
+                .collect::<Vec<_>>()
+                .join("&")
+                .into_bytes(),
+            Some("application/x-www-form-urlencoded".to_owned()),
+        ),
+        Some(Native::Str(text)) => (text.as_bytes().to_vec(), None),
+        Some(Native::RespBody(bytes)) => (bytes.clone(), None),
+        Some(Native::RequestBody { data, content_type }) => (data.clone(), content_type.clone()),
+        _ => {
+            // A guest-defined RequestBody owns its serialization. Do not drop
+            // an unknown body or treat its data as a lossy UTF-8 string.
+            let media = inv_virt(vm, body, "contentType", "()Lokhttp3/MediaType;", &[])?;
+            let content_type = if media.is_null() {
+                None
+            } else {
+                Some(jstr(vm, media)?)
+            };
+            let sink = alloc(
+                vm,
+                "Lokio/Buffer;",
+                Native::OkioBuf {
+                    bytes: Vec::new(),
+                    pos: 0,
+                },
+            )?;
+            inv_virt(vm, body, "writeTo", "(Lokio/BufferedSink;)V", &[sink])?;
+            let Some(Native::OkioBuf { bytes, .. }) = payload(vm, sink) else {
+                return Err(ioe(vm, "Invalid request body buffer"));
+            };
+            (bytes.clone(), content_type)
+        }
+    };
+    if bytes.len() > 1_000_000 {
+        return Err(ioe(vm, "Request body exceeds the host limit"));
+    }
+    Ok((Some(bytes), content_type))
 }

